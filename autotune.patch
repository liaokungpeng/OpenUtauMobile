@@ -0,0 +1,415 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenUtau.Core;
+using OpenUtau.Core.Format;
+using UstxConst = OpenUtau.Core.Format.Ustx;
+using OpenUtau.Core.Ustx;
+
+namespace OpenUtauMobile.Utils.AutoTune
+{
+    /// <summary>
+    /// 调音参数集合。
+    /// 对应桌面版 OpenUtau 在「音符属性 / 音高锚点 / 颤音 / 表情」里可以调的项，
+    /// 只保留移动端真正用得上的数值项，单位尽量与桌面版保持一致：
+    ///   - 音高类：0.1 半音（PitchPoint.Y 的单位）
+    ///   - 颤音类：与 UVibrato 相同（length/in/out/shift/volLink 为百分比，period 为毫秒，depth 为音分）
+    /// </summary>
+    public class AutoTuneSettings
+    {
+        /// <summary>滑音长度（毫秒）：从起音音高滑到本音高所需的时间。</summary>
+        public float PortamentoMs = 80f;
+        /// <summary>滑音提前量（毫秒）：把滑音起点提前到音符开始之前，仅对连音音符生效。</summary>
+        public float PortamentoLeadMs = 0f;
+        /// <summary>起音下探深度（音分）：非连音时从低于本音高的位置滑进来。</summary>
+        public float ScoopCents = 50f;
+        /// <summary>过冲（音分）：滑到位后略微冲过头再回落，用来模拟人声。</summary>
+        public float OvershootCents = 0f;
+        /// <summary>随机音准抖动（音分）：每个音符结尾的随机偏移。</summary>
+        public float JitterCents = 6f;
+        /// <summary>短于该时长（毫秒）的音符不做滑音。</summary>
+        public float MinNoteMs = 60f;
+
+        /// <summary>是否写入颤音。</summary>
+        public bool VibratoEnabled = true;
+        /// <summary>颤音占音符长度的百分比。</summary>
+        public float VibratoLengthPct = 35f;
+        /// <summary>颤音周期（毫秒）。</summary>
+        public float VibratoPeriodMs = 175f;
+        /// <summary>颤音深度（音分）。</summary>
+        public float VibratoDepthCents = 25f;
+        /// <summary>颤音淡入（占颤音长度的百分比）。</summary>
+        public float VibratoInPct = 25f;
+        /// <summary>颤音淡出（占颤音长度的百分比）。</summary>
+        public float VibratoOutPct = 25f;
+        /// <summary>颤音相位偏移（百分比）。</summary>
+        public float VibratoShiftPct = 0f;
+        /// <summary>颤音整体漂移（百分比）。</summary>
+        public float VibratoDriftPct = 0f;
+        /// <summary>颤音与音量联动（百分比）。</summary>
+        public float VibratoVolLinkPct = 0f;
+        /// <summary>短于该时长（毫秒）的音符不写颤音。</summary>
+        public float VibratoMinNoteMs = 300f;
+
+        /// <summary>是否同时写入表情。</summary>
+        public bool ApplyExpressions = false;
+        /// <summary>
+        /// 表情缩写 -> 百分比（0~100，50 等于该表情的默认值）。
+        /// 曲线类表情（genc / dyn / brec …）写进对应表情车道，数值类写到音符上。
+        /// 面板按工程里注册的表情动态填充，这里不做固定字段。
+        /// </summary>
+        public Dictionary<string, double> Expressions = new();
+    }
+
+    /// <summary>
+    /// 自动调音核心：只负责「算出要下的命令」，不碰界面，方便单独测试。
+    /// 生成的是音符自带的音高锚点（UNote.pitch）和颤音（UNote.vibrato），
+    /// 与桌面版手动调出来的数据完全同构，导回桌面版也能继续编辑。
+    /// </summary>
+    public static class AutoTuneEngine
+    {
+        /// <summary>与音符绑定的表情缩写，顺序决定写入顺序。</summary>
+        public static readonly string[] NoteExpressionAbbrs = {
+            UstxConst.DYN, UstxConst.TENC, UstxConst.BREC, UstxConst.GENC, UstxConst.VOIC, UstxConst.VEL,
+        };
+
+        /// <summary>
+        /// 生成应用自动调音所需的命令列表（音高锚点 + 颤音 + 可选表情）。
+        /// </summary>
+        public static List<UCommand> BuildCommands(
+            UProject project,
+            UVoicePart part,
+            IReadOnlyList<UNote> notes,
+            AutoTuneSettings settings)
+        {
+            var commands = new List<UCommand>();
+            if (project == null || part == null || notes == null || notes.Count == 0)
+            {
+                return commands;
+            }
+
+            // 固定种子：同一份工程反复应用的结果一致，避免每次听感都不一样。
+            var random = new Random(20260101);
+            var targets = notes.Where(n => n != null && !IsRest(n)).ToList();
+            if (targets.Count == 0)
+            {
+                return commands;
+            }
+
+            foreach (var note in targets)
+            {
+                commands.Add(new SetPitchPointsCommand(part, note, BuildPitch(note, settings, random)));
+                commands.Add(new SetVibratoCommand(part, note, BuildVibrato(note, settings)));
+            }
+
+            if (settings.ApplyExpressions && settings.Expressions.Count > 0)
+            {
+                var track = part.trackNo >= 0 && part.trackNo < project.tracks.Count
+                    ? project.tracks[part.trackNo]
+                    : null;
+                if (track != null)
+                {
+                    foreach (var item in settings.Expressions)
+                    {
+                        if (!project.expressions.TryGetValue(item.Key, out var descriptor))
+                        {
+                            continue;
+                        }
+                        if (descriptor.type == UExpressionType.Options)
+                        {
+                            continue;
+                        }
+                        float pct = Clamp((float)item.Value, 0f, 100f);
+                        if (descriptor.type == UExpressionType.Curve)
+                        {
+                            // 曲线类表情（genc / dyn / brec…）在钢琴卷帘里是「轨道曲线」，
+                            // 写音符级数值那条线不会动，必须写曲线。
+                            float span = (descriptor.max - descriptor.min) / 2f;
+                            float curveValue = descriptor.defaultValue + (pct - 50f) / 50f * span;
+                            curveValue = Math.Clamp(curveValue, descriptor.min, descriptor.max);
+                            int startTick = targets.Min(n => n.position);
+                            int endTick = targets.Max(n => n.position + n.duration);
+                            if (endTick > startTick)
+                            {
+                                commands.Add(new SetCurveConstantCommand(
+                                    part, descriptor, startTick, endTick,
+                                    (int)Math.Round(curveValue)));
+                            }
+                        }
+                        else
+                        {
+                            float value = descriptor.min + (descriptor.max - descriptor.min) * pct / 100f;
+                            commands.Add(new SetNotesSameExpressionCommand(
+                                project, track, part, targets, item.Key, value));
+                        }
+                    }
+                }
+            }
+
+            return commands;
+        }
+
+        /// <summary>
+        /// 生成清除音高锚点与颤音所需的命令。
+        /// </summary>
+        public static List<UCommand> BuildClearCommands(UVoicePart part, IReadOnlyList<UNote> notes)
+        {
+            var commands = new List<UCommand>();
+            if (part == null || notes == null)
+            {
+                return commands;
+            }
+            foreach (var note in notes.Where(n => n != null && !IsRest(n)))
+            {
+                commands.Add(new ResetPitchPointsCommand(part, note));
+                var vibrato = new UVibrato { length = 0f };
+                commands.Add(new SetVibratoCommand(part, note, vibrato));
+            }
+            return commands;
+        }
+
+        /// <summary>
+        /// 算出单个音符的音高锚点。
+        /// 说明：PitchPoint.X 是相对音符开始的毫秒数，Y 是 0.1 半音为单位的偏移。
+        /// 连音时从上一个音符的音高滑入，非连音时从下方「下探」滑入。
+        /// </summary>
+        public static UPitch BuildPitch(UNote note, AutoTuneSettings settings, Random random)
+        {
+            var pitch = new UPitch();
+            double durationMs = Math.Max(1.0, note.DurationMs);
+            float duration = (float)durationMs;
+
+            float portamento = Clamp(settings.PortamentoMs, 0f, duration * 0.9f);
+            UNote? prev = note.Prev;
+            bool legato = prev != null
+                && prev.End == note.position
+                && !IsRest(prev);
+            bool longEnough = durationMs >= settings.MinNoteMs;
+
+            float lead = 0f;
+            if (legato && settings.PortamentoLeadMs > 0f)
+            {
+                // 提前量不能超过滑音长度，否则起点会落到上一个音符里造成重复叠加。
+                lead = Clamp(settings.PortamentoLeadMs, 0f, portamento);
+            }
+
+            float startY;
+            if (!longEnough)
+            {
+                // 短音不做任何处理，保持原样。
+                pitch.AddPoint(new PitchPoint(0f, 0f, PitchPointShape.io));
+                pitch.AddPoint(new PitchPoint(duration, 0f, PitchPointShape.io));
+                return pitch;
+            }
+
+            if (legato)
+            {
+                // 从上一个音符的音高出发。
+                startY = Clamp((prev!.tone - note.tone) * 10f, -240f, 240f);
+            }
+            else if (settings.ScoopCents > 0f)
+            {
+                // 从下方滑入，模拟换气后的起音。
+                startY = -Clamp(settings.ScoopCents, 0f, 600f) / 10f;
+            }
+            else
+            {
+                startY = 0f;
+            }
+
+            float startX = lead > 0f ? -lead : 0f;
+            float settleX = startX + Math.Max(1f, portamento);
+            settleX = Math.Min(settleX, duration);
+            float jitterY = settings.JitterCents > 0f
+                ? (float)(random.NextDouble() * 2.0 - 1.0) * Clamp(settings.JitterCents, 0f, 100f) / 10f
+                : 0f;
+
+            pitch.AddPoint(new PitchPoint(startX, startY, PitchPointShape.io));
+            pitch.AddPoint(new PitchPoint(settleX, 0f, PitchPointShape.io));
+
+            float overshoot = Clamp(settings.OvershootCents, 0f, 300f) / 10f;
+            if (overshoot > 0.01f && duration - settleX > 40f)
+            {
+                // 冲过头再回落。
+                float peakX = Math.Min(settleX + Math.Max(20f, (duration - settleX) * 0.25f), duration - 1f);
+                float backX = Math.Min(peakX + Math.Max(30f, (duration - settleX) * 0.3f), duration);
+                pitch.AddPoint(new PitchPoint(peakX, overshoot, PitchPointShape.io));
+                pitch.AddPoint(new PitchPoint(backX, jitterY, PitchPointShape.io));
+            }
+            else if (duration - settleX > 1f)
+            {
+                pitch.AddPoint(new PitchPoint(duration, jitterY, PitchPointShape.io));
+            }
+
+            return Normalize(pitch, duration);
+        }
+
+        /// <summary>
+        /// 算出单个音符的颤音参数。
+        /// </summary>
+        public static UVibrato BuildVibrato(UNote note, AutoTuneSettings settings)
+        {
+            var vibrato = new UVibrato();
+            float period = Clamp(settings.VibratoPeriodMs, 5f, 500f);
+            // 至少要容得下 1.5 个周期，否则短音符上会出现半截「鼓包」而不是颤音。
+            float minDuration = Math.Max(settings.VibratoMinNoteMs, period * 1.5f);
+            if (!settings.VibratoEnabled || note.DurationMs < minDuration)
+            {
+                vibrato.length = 0f;
+                return vibrato;
+            }
+            vibrato.length = Clamp(settings.VibratoLengthPct, 1f, 100f);
+            vibrato.period = period;
+            vibrato.depth = Clamp(settings.VibratoDepthCents, 5f, 200f);
+            // in / out 的 setter 会互相挤占，先设 in 再设 out，最后按需回写 in。
+            vibrato.@in = Clamp(settings.VibratoInPct, 0f, 100f);
+            vibrato.@out = Clamp(settings.VibratoOutPct, 0f, 100f);
+            vibrato.shift = Clamp(settings.VibratoShiftPct, 0f, 100f);
+            vibrato.drift = Clamp(settings.VibratoDriftPct, -100f, 100f);
+            vibrato.volLink = Clamp(settings.VibratoVolLinkPct, -100f, 100f);
+            return vibrato;
+        }
+
+        /// <summary>
+        /// 排序、去重、并把锚点收进音符范围，避免出现 X 重复或越界的点。
+        /// </summary>
+        private static UPitch Normalize(UPitch pitch, float duration)
+        {
+            var points = pitch.data
+                .OrderBy(p => p.X)
+                .ToList();
+            pitch.data.Clear();
+            float lastX = float.NegativeInfinity;
+            foreach (var point in points)
+            {
+                float x = Math.Min(point.X, duration);
+                if (x - lastX < 1f)
+                {
+                    continue;
+                }
+                point.X = x;
+                pitch.data.Add(point);
+                lastX = x;
+            }
+            if (pitch.data.Count == 0)
+            {
+                pitch.data.Add(new PitchPoint(0f, 0f, PitchPointShape.io));
+            }
+            if (pitch.data.Count == 1)
+            {
+                pitch.data.Add(new PitchPoint(duration, pitch.data[0].Y, PitchPointShape.io));
+            }
+            return pitch;
+        }
+
+        /// <summary>休止符判定：歌词为 R（不区分大小写）。</summary>
+        public static bool IsRest(UNote note)
+        {
+            return note == null || string.Equals(note.lyric?.Trim(), "R", StringComparison.OrdinalIgnoreCase);
+        }
+
+        private static float Clamp(float value, float min, float max)
+        {
+            if (float.IsNaN(value))
+            {
+                return min;
+            }
+            return Math.Min(max, Math.Max(min, value));
+        }
+    }
+}
+
+namespace OpenUtauMobile.Utils.AutoTune
+{
+    /// <summary>
+    /// 把一条轨道表情曲线在 [startTick, endTick] 内设成常量。
+    /// 曲线类表情（genc / dyn / brec / voic…）只能这样写，写音符级数值不会让那条线动。
+    /// </summary>
+    public sealed class SetCurveConstantCommand : OpenUtau.Core.UCommand
+    {
+        readonly UVoicePart part;
+        readonly UExpressionDescriptor descriptor;
+        readonly int startTick;
+        readonly int endTick;
+        readonly int value;
+        UCurve? curve;
+        bool created;
+        List<int>? oldXs;
+        List<int>? oldYs;
+
+        public override OpenUtau.Core.ValidateOptions ValidateOptions => new OpenUtau.Core.ValidateOptions
+        {
+            SkipTiming = true,
+            Part = part,
+            SkipPhonemizer = true,
+            SkipPhoneme = true,
+        };
+
+        public SetCurveConstantCommand(UVoicePart part, UExpressionDescriptor descriptor, int startTick, int endTick, int value)
+        {
+            this.part = part;
+            this.descriptor = descriptor;
+            this.startTick = Math.Min(startTick, endTick);
+            this.endTick = Math.Max(startTick, endTick);
+            this.value = (int)Math.Clamp(value, descriptor.min, descriptor.max);
+        }
+
+        public override void Execute()
+        {
+            curve = part.curves.FirstOrDefault(c => c.abbr == descriptor.abbr);
+            if (curve == null)
+            {
+                curve = new UCurve(descriptor);
+                part.curves.Add(curve);
+                created = true;
+            }
+            oldXs = curve.xs.ToList();
+            oldYs = curve.ys.ToList();
+
+            var xs = new List<int>();
+            var ys = new List<int>();
+            for (int i = 0; i < oldXs.Count; i++)
+            {
+                if (oldXs[i] < startTick || oldXs[i] > endTick)
+                {
+                    xs.Add(oldXs[i]);
+                    ys.Add(oldYs[i]);
+                }
+            }
+            Insert(xs, ys, startTick, value);
+            Insert(xs, ys, endTick, value);
+            curve.xs = xs;
+            curve.ys = ys;
+        }
+
+        public override void Unexecute()
+        {
+            if (curve == null)
+            {
+                return;
+            }
+            if (created)
+            {
+                part.curves.Remove(curve);
+                return;
+            }
+            curve.xs = oldXs!.ToList();
+            curve.ys = oldYs!.ToList();
+        }
+
+        static void Insert(List<int> xs, List<int> ys, int x, int y)
+        {
+            int idx = xs.BinarySearch(x);
+            if (idx >= 0)
+            {
+                ys[idx] = y;
+                return;
+            }
+            idx = ~idx;
+            xs.Insert(idx, x);
+            ys.Insert(idx, y);
+        }
+
+        public override string ToString() => $"Set curve {descriptor.abbr}";
+    }
+}
diff --git a/OpenUtauMobile/Utils/AutoTune/AutoTunePresetStore.cs b/OpenUtauMobile/Utils/AutoTune/AutoTunePresetStore.cs
