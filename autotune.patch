+
+    private void AddSlider(VerticalStackLayout parent, string key, string title, double min, double max, double value, string unit)
+    {
+        const int decimals = 0;
+        _values[key] = value;
+        _defaults[key] = value;
+        _units[key] = unit;
+        _decimals[key] = decimals;
+
+        var valueLabel = new Label
+        {
+            Text = Format(value, unit, decimals),
