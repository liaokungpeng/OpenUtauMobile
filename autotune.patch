+
+    #endregion
+
+    #region 预设
+
+    private void ApplyPreset(int index)
+    {
+        _lastPresetIndex = index;
+        if (index >= PresetNames.Length)
+        {
+            int customIndex = index - PresetNames.Length;
+            if (customIndex >= 0 && customIndex < _customPresets.Count)
+            {
+                ApplyCustomPreset(_customPresets[customIndex]);
+            }
+            return;
+        }
+        _syncing = true;
+        try
+        {
+            ResetExpressions();
+            switch (index)
+            {
+                case 1: // 标准：接近桌面版默认 Portamento/Vibrato 预设
+                    SetValues(("portamento", 80), ("lead", 40), ("scoop", 40), ("overshoot", 10), ("jitter", 4),
+                        ("vibLength", 40), ("vibPeriod", 175), ("vibDepth", 30), ("vibIn", 20), ("vibOut", 20));
+                    SetVibrato(true);
+                    SetExpressions(("dyn", 55), ("tenc", 55), ("vel", 55));
+                    break;
+                case 2: // 强颤音
+                    SetValues(("portamento", 70), ("lead", 30), ("scoop", 30), ("overshoot", 0), ("jitter", 3),
+                        ("vibLength", 55), ("vibPeriod", 190), ("vibDepth", 55), ("vibIn", 25), ("vibOut", 25));
+                    SetVibrato(true);
+                    SetExpressions(("tenc", 60), ("dyn", 55));
+                    break;
+                case 3: // 电音：几乎不滑音、不颤音，音头干净
+                    SetValues(("portamento", 12), ("lead", 0), ("scoop", 0), ("overshoot", 0), ("jitter", 0),
+                        ("vibLength", 10), ("vibPeriod", 160), ("vibDepth", 8), ("vibIn", 50), ("vibOut", 50));
+                    SetVibrato(true);
+                    SetExpressions(("dyn", 70), ("tenc", 65), ("brec", 25));
+                    break;
+                case 4: // 古风柔滑：长滑音 + 慢颤音
+                    SetValues(("portamento", 150), ("lead", 80), ("scoop", 90), ("overshoot", 0), ("jitter", 8),
+                        ("vibLength", 60), ("vibPeriod", 210), ("vibDepth", 30), ("vibIn", 35), ("vibOut", 40));
+                    SetVibrato(true);
+                    SetExpressions(("dyn", 45), ("brec", 45), ("genc", 55));
+                    break;
+                case 5: // 朗读：轻滑音，不颤
+                    SetValues(("portamento", 30), ("lead", 0), ("scoop", 20), ("overshoot", 0), ("jitter", 5));
+                    SetVibrato(false);
+                    SetExpressions(("dyn", 60), ("vel", 70));
+                    break;
+                case 6: // 明亮少女
+                    SetValues(("portamento", 90), ("lead", 20), ("scoop", 60), ("overshoot", 10), ("jitter", 4),
+                        ("vibLength", 35), ("vibPeriod", 165), ("vibDepth", 28), ("vibIn", 25), ("vibOut", 25));
+                    SetVibrato(true);
+                    SetExpressions(("genc", 70), ("dyn", 60));
+                    break;
+                case 7: // 低沉大叔
+                    SetValues(("portamento", 120), ("lead", 40), ("scoop", 80), ("overshoot", 5), ("jitter", 6),
+                        ("vibLength", 55), ("vibPeriod", 200), ("vibDepth", 32), ("vibIn", 30), ("vibOut", 35));
+                    SetVibrato(true);
+                    SetExpressions(("genc", 25), ("dyn", 65), ("tenc", 45));
+                    break;
+                case 8: // 气声耳语
+                    SetValues(("portamento", 60), ("lead", 0), ("scoop", 30), ("overshoot", 0), ("jitter", 8),
+                        ("vibLength", 25), ("vibPeriod", 210), ("vibDepth", 12), ("vibIn", 40), ("vibOut", 45));
+                    SetVibrato(true);
+                    SetExpressions(("brec", 85), ("dyn", 40));
+                    break;
+                case 9: // 摇滚爆发
+                    SetValues(("portamento", 70), ("lead", 25), ("scoop", 40), ("overshoot", 20), ("jitter", 9),
+                        ("vibLength", 60), ("vibPeriod", 150), ("vibDepth", 45), ("vibIn", 15), ("vibOut", 20));
+                    SetVibrato(true);
+                    SetExpressions(("dyn", 85), ("tenc", 80));
+                    break;
+                default: // 自然
+                    SetValues(("portamento", 80), ("lead", 0), ("scoop", 50), ("overshoot", 0), ("jitter", 6),
+                        ("vibLength", 35), ("vibPeriod", 175), ("vibDepth", 25), ("vibIn", 25), ("vibOut", 25),
+                        ("vibShift", 0), ("vibDrift", 0), ("vibVolLink", 0));
+                    SetVibrato(true);
+                    break;
+            }
+        }
+        finally
+        {
+            _syncing = false;
+        }
+    }
+
+    /// <summary>
+    /// 应用 .oudep 预设包里的预设：预设没写的参数回落到面板默认值，
+    /// 超范围的值按滑杆上下限裁剪。
+    /// </summary>
+    private void ApplyCustomPreset(AutoTunePreset preset)
+    {
+        _syncing = true;
+        try
+        {
+            foreach (var key in _values.Keys.ToList())
+            {
+                double value = preset.Values.TryGetValue(key, out double custom) ? custom : _defaults[key];
+                if (_sliders.TryGetValue(key, out var slider))
+                {
+                    value = Math.Clamp(value, slider.Minimum, slider.Maximum);
+                    slider.Value = value;
+                }
+                _values[key] = value;
+                if (_valueLabels.TryGetValue(key, out var label))
+                {
+                    label.Text = Format(value, _units[key], _decimals[key]);
+                }
+            }
+            if (preset.ExpressionValues.Count > 0)
+            {
+                SetExpressions(preset.ExpressionValues.Select(kv => (kv.Key, kv.Value)).ToArray());
+                // 预设带表情就自动打开总开关，避免「选了预设但表情没写」。
+                if (_expressionSwitch != null)
+                {
+                    _expressionSwitch.IsToggled = true;
+                }
+            }
+            SetVibrato(preset.Vibrato ?? true);
+            if (preset.ExpressionsEnabled.HasValue && _expressionSwitch != null)
+            {
+                _expressionSwitch.IsToggled = preset.ExpressionsEnabled.Value;
+            }
+        }
+        finally
+        {
+            _syncing = false;
+        }
+    }
+
+    private static List<AutoTunePreset> LoadCustomPresets()
+    {
+        try
+        {
+            return AutoTunePresetStore.Load(onError: message => Log.Warning("预设包问题：{Message}", message));
+        }
+        catch (Exception ex)
+        {
+            Log.Error(ex, "读取调音预设包失败");
+            return new List<AutoTunePreset>();
+        }
+    }
+
+    private List<string> BuildPresetNames()
+    {
+        var names = new List<string>(PresetNames);
+        foreach (var preset in _customPresets)
+        {
+            string label = preset.Name;
+            if (names.Contains(label) && !string.IsNullOrEmpty(preset.Source))
+            {
+                label = $"{preset.Name}（{preset.Source}）";
+            }
+            string candidate = label;
+            int suffix = 2;
+            while (names.Contains(candidate))
+            {
+                candidate = $"{label} {suffix++}";
+            }
+            names.Add(candidate);
+        }
+        return names;
+    }
+
+    private static string ExpressionKey(string abbr) => "exp:" + abbr;
+
+    /// <summary>收集当前面板上的表情百分比（开关关闭时为空）。</summary>
+    private Dictionary<string, double> BuildExpressionValues()
+    {
+        var values = new Dictionary<string, double>();
+        if (_expressionSwitch?.IsToggled != true)
+        {
+            return values;
+        }
+        foreach (var descriptor in _expressionDescriptors)
+        {
+            if (_values.TryGetValue(ExpressionKey(descriptor.abbr), out double pct))
+            {
+                values[descriptor.abbr] = pct;
+            }
+        }
+        return values;
+    }
+
+    /// <summary>把表情滑杆全部复位到默认值（50%）。</summary>
+    private void ResetExpressions()
+    {
+        foreach (var descriptor in _expressionDescriptors)
+        {
+            string key = ExpressionKey(descriptor.abbr);
+            if (_defaults.TryGetValue(key, out double fallback))
+            {
+                SetValues((key, fallback));
+            }
+        }
+    }
+
+    private void SetExpressions(params (string Abbr, double Pct)[] pairs)
+    {
+        foreach (var pair in pairs)
+        {
+            string key = ExpressionKey(pair.Abbr);
+            if (!_values.ContainsKey(key))
+            {
+                continue;
+            }
+            SetValues((key, pair.Pct));
+        }
+    }
+
+    private void SetValues(params (string Key, double Value)[] pairs)
+    {
+        foreach (var pair in pairs)
+        {
+            if (!_values.ContainsKey(pair.Key))
+            {
+                continue;
+            }
+            _values[pair.Key] = pair.Value;
+            if (_sliders.TryGetValue(pair.Key, out var slider))
+            {
+                slider.Value = Math.Clamp(pair.Value, slider.Minimum, slider.Maximum);
+            }
+            if (_valueLabels.TryGetValue(pair.Key, out var label))
+            {
+                label.Text = Format(pair.Value, _units[pair.Key], _decimals[pair.Key]);
+            }
+        }
+    }
+
+    private void SetVibrato(bool enabled)
+    {
+        if (_vibratoSwitch != null)
+        {
+            _vibratoSwitch.IsToggled = enabled;
+        }
+    }
+
+    #endregion
+
+    #region 执行
+
+    private AutoTuneSettings BuildSettings()
+    {
+        double Read(string key, double fallback) => _values.TryGetValue(key, out var v) ? v : fallback;
+
+        return new AutoTuneSettings
+        {
+            PortamentoMs = (float)Read("portamento", 80),
+            PortamentoLeadMs = (float)Read("lead", 0),
+            ScoopCents = (float)Read("scoop", 50),
+            OvershootCents = (float)Read("overshoot", 0),
+            JitterCents = (float)Read("jitter", 6),
+            VibratoEnabled = _vibratoSwitch?.IsToggled ?? true,
+            VibratoLengthPct = (float)Read("vibLength", 35),
+            VibratoPeriodMs = (float)Read("vibPeriod", 175),
+            VibratoDepthCents = (float)Read("vibDepth", 25),
+            VibratoInPct = (float)Read("vibIn", 25),
+            VibratoOutPct = (float)Read("vibOut", 25),
+            VibratoShiftPct = (float)Read("vibShift", 0),
+            VibratoDriftPct = (float)Read("vibDrift", 0),
+            VibratoVolLinkPct = (float)Read("vibVolLink", 0),
+            ApplyExpressions = _expressionSwitch?.IsToggled ?? false,
+            Expressions = BuildExpressionValues(),
+        };
+    }
+
+    private async void OnApplyClicked(object? sender, EventArgs e)
+    {
+        if (_notes.Count == 0)
+        {
+            return;
+        }
+        var project = DocManager.Inst.Project;
+        if (project == null)
+        {
+            return;
+        }
+        try
+        {
+            var settings = BuildSettings();
+            var commands = AutoTuneEngine.BuildCommands(project, _part, _notes, settings);
+            if (commands.Count == 0)
+            {
+                await Toast.Make("没有可调音的音符", ToastDuration.Short).Show();
+                return;
+            }
+            DocManager.Inst.StartUndoGroup(deferValidate: true);
+            try
+            {
+                foreach (var command in commands)
+                {
+                    DocManager.Inst.ExecuteCmd(command);
+                }
+                DocManager.Inst.EndUndoGroup();
+            }
+            catch
+            {
+                // 中途失败要回滚并关掉撤销组，否则后续每次都会报 undoGroup already started。
+                DocManager.Inst.RollBackUndoGroup();
+                throw;
+            }
+            string summary =
+                $"滑音{settings.PortamentoMs:F0}ms 颤音{(settings.VibratoEnabled ? settings.VibratoDepthCents.ToString("F0") : "关")}" +
+                (settings.ApplyExpressions && settings.Expressions.Count > 0
+                    ? $" 表情{settings.Expressions.Count}项"
+                    : " 未写表情");
+            Log.Information("AutoTune apply: " + summary);
+            // 写日志放到后台，避免存储权限不对时卡住界面。
+            string logLine = summary + $" notes={_notes.Count} commands={commands.Count}";
+            _ = Task.Run(() => WriteApplyLog(logLine));
+            await Toast.Make($"已调音 {_notes.Count} 个音符 · {summary}", ToastDuration.Long).Show();
+            await Navigation.PopModalAsync();
+        }
+        catch (Exception ex)
+        {
+            Log.Error(ex, "自动调音失败");
+            await DisplayAlert("调音失败", ex.Message, "好");
+        }
+    }
+
+    /// <summary>
+    /// 把这次实际用到的参数写到手机存储，方便排查「调了却没变化」。
+    /// </summary>
+    private void WriteApplyLog(string line)
+    {
+        foreach (string dir in new[] { "/sdcard/Download/DSH-Go", "/sdcard/Download", "/sdcard" })
+        {
+            try
+            {
+                Directory.CreateDirectory(dir);
+                File.AppendAllText(
+                    Path.Combine(dir, "autotune-log.txt"),
+                    $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] {line}{Environment.NewLine}");
+                return;
+            }
+            catch (Exception ex)
+            {
+                Log.Warning("写入调音日志失败 {Dir}：{Message}", dir, ex.Message);
+            }
+        }
+    }
+
+    private async void OnClearClicked(object? sender, EventArgs e)
+    {
+        if (_notes.Count == 0)
+        {
+            return;
+        }
+        try
+        {
+            var commands = AutoTuneEngine.BuildClearCommands(_part, _notes);
+            if (commands.Count == 0)
+            {
+                return;
+            }
+            DocManager.Inst.StartUndoGroup(deferValidate: true);
+            try
+            {
+                foreach (var command in commands)
+                {
+                    DocManager.Inst.ExecuteCmd(command);
+                }
+                DocManager.Inst.EndUndoGroup();
+            }
+            catch
+            {
+                DocManager.Inst.RollBackUndoGroup();
+                throw;
+            }
+            await Toast.Make("已清除音高与颤音", ToastDuration.Short).Show();
+            await Navigation.PopModalAsync();
+        }
+        catch (Exception ex)
+        {
+            Log.Error(ex, "清除音高失败");
+            await DisplayAlert("清除失败", ex.Message, "好");
+        }
+    }
+
+    #endregion
+
+    private string BuildSummaryText()
+    {
+        int singable = _notes.Count(n => !AutoTuneEngine.IsRest(n));
+        return _notes.Count == 0
+            ? "当前分片没有可调音的音符"
+            : $"作用范围：{_notes.Count} 个音符（其中 {singable} 个可发音），未选中时默认整个分片";
+    }
+
+    private static string Format(double value, string unit, int decimals)
+    {
+        string number = decimals > 0 ? value.ToString("F" + decimals) : Math.Round(value).ToString("F0");
+        return string.IsNullOrEmpty(unit) ? number : $"{number} {unit}";
+    }
+}
