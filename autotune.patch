@@ -0,0 +1,321 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using OpenUtau.Core;
+using OpenUtau.Core.Util;
+
+namespace OpenUtauMobile.Utils.AutoTune
+{
+    /// <summary>
+    /// 一个调音预设。Values 的键与调音面板的滑杆键一致
+    /// （portamento / lead / scoop / overshoot / jitter / vibLength … / dyn …），
+    /// 没写的键在应用时回落到默认值。
+    /// </summary>
+    public sealed class AutoTunePreset
+    {
+        public string Name { get; init; } = string.Empty;
+        /// <summary>来源包名，用于重名时区分。</summary>
+        public string Source { get; init; } = string.Empty;
+        public Dictionary<string, double> Values { get; init; } = new();
+        /// <summary>表情缩写 -> 百分比（0~100）。</summary>
+        public Dictionary<string, double> ExpressionValues { get; init; } = new();
+        public bool? Vibrato { get; init; }
+        public bool? ExpressionsEnabled { get; init; }
+    }
+
+    /// <summary>
+    /// 从依赖目录读取 .oudep 预设包。
+    /// 约定：包根目录下放 autotune.yaml，内容见 docs 里的说明。
+    /// </summary>
+    public static class AutoTunePresetStore
+    {
+        public const string PresetFileName = "autotune.yaml";
+
+        /// <summary>与调音面板一致的滑杆键。</summary>
+        public static readonly string[] SliderKeys =
+        {
+            "portamento", "lead", "scoop", "overshoot", "jitter",
+            "vibLength", "vibPeriod", "vibDepth", "vibIn", "vibOut",
+            "vibShift", "vibDrift", "vibVolLink",
+        };
+
+        private static readonly Dictionary<string, string> KeyMap = BuildKeyMap();
+
+        /// <summary>
+        /// 扫描依赖目录，返回所有可用的自定义预设。
+        /// 单个包出错不影响其他包，错误通过 onError 报告。
+        /// </summary>
+        public static List<AutoTunePreset> Load(string? dependenciesRoot = null, Action<string>? onError = null)
+        {
+            var presets = new List<AutoTunePreset>();
+            string? root = dependenciesRoot;
+            if (string.IsNullOrEmpty(root))
+            {
+                try
+                {
+                    root = PathManager.Inst.DependencyPath;
+                }
+                catch (Exception ex)
+                {
+                    onError?.Invoke($"无法定位依赖目录：{ex.Message}");
+                    return presets;
+                }
+            }
+            if (string.IsNullOrEmpty(root) || !Directory.Exists(root))
+            {
+                return presets;
+            }
+
+            string[] dirs;
+            try
+            {
+                dirs = Directory.GetDirectories(root);
+            }
+            catch (Exception ex)
+            {
+                onError?.Invoke($"无法读取依赖目录：{ex.Message}");
+                return presets;
+            }
+            Array.Sort(dirs, StringComparer.OrdinalIgnoreCase);
+
+            foreach (var dir in dirs)
+            {
+                string file = Path.Combine(dir, PresetFileName);
+                if (!File.Exists(file))
+                {
+                    continue;
+                }
+                string packName = Path.GetFileName(dir);
+                try
+                {
+                    string text = File.ReadAllText(file);
+                    presets.AddRange(Parse(text, packName));
+                }
+                catch (Exception ex)
+                {
+                    onError?.Invoke($"{packName}: {ex.Message}");
+                }
+            }
+            return presets;
+        }
+
+        /// <summary>
+        /// 解析一个 autotune.yaml。格式：
+        /// <code>
+        /// presets:
+        ///   - name: 柔滑女声
+        ///     portamento: 130
+        ///     vib_length: 50
+        ///     vibrato: true
+        /// </code>
+        /// 键名大小写、下划线、连字符都可以随意写。
+        /// </summary>
+        public static List<AutoTunePreset> Parse(string yaml, string source = "")
+        {
+            var result = new List<AutoTunePreset>();
+            if (string.IsNullOrWhiteSpace(yaml))
+            {
+                return result;
+            }
+
+            List<Dictionary<string, object?>>? entries = null;
+            Exception? wrappedError = null;
+            try
+            {
+                var wrapped = OpenUtau.Core.Yaml.DefaultDeserializer.Deserialize<PresetFile>(yaml);
+                entries = wrapped?.presets;
+            }
+            catch (Exception ex)
+            {
+                wrappedError = ex;
+                entries = null;
+            }
+
+            if (entries == null)
+            {
+                try
+                {
+                    // 也允许直接写成顶层列表
+                    entries = OpenUtau.Core.Yaml.DefaultDeserializer.Deserialize<List<Dictionary<string, object?>>>(yaml);
+                }
+                catch (Exception) when (wrappedError != null)
+                {
+                    throw new FormatException($"autotune.yaml 格式不对：{wrappedError.Message}", wrappedError);
+                }
+            }
+
+            if (entries == null)
+            {
+                return result;
+            }
+
+            foreach (var entry in entries)
+            {
+                if (entry == null)
+                {
+                    continue;
+                }
+                AutoTunePreset? preset = ToPreset(entry, source);
+                if (preset != null)
+                {
+                    result.Add(preset);
+                }
+            }
+            return result;
+        }
+
+        private static AutoTunePreset? ToPreset(Dictionary<string, object?> entry, string source)
+        {
+            string name = string.Empty;
+            var values = new Dictionary<string, double>();
+            var expressionValues = new Dictionary<string, double>();
+            bool? vibrato = null;
+            bool? expressions = null;
+
+            foreach (var pair in entry)
+            {
+                string? key = NormalizeKey(pair.Key);
+                if (key == null)
+                {
+                    continue;
+                }
+                switch (key)
+                {
+                    case "name":
+                        name = pair.Value?.ToString()?.Trim() ?? string.Empty;
+                        continue;
+                    case "vibrato":
+                        vibrato = ToBool(pair.Value) ?? vibrato;
+                        continue;
+                    case "expressions":
+                    case "expression":
+                        expressions = ToBool(pair.Value) ?? expressions;
+                        continue;
+                }
+                double? parsed = ToDouble(pair.Value);
+                if (!parsed.HasValue)
+                {
+                    continue;
+                }
+                if (KeyMap.TryGetValue(key, out var sliderKey))
+                {
+                    values[sliderKey] = parsed.Value;
+                }
+                else if (!string.IsNullOrEmpty(key))
+                {
+                    // 认不出来就当表情缩写（genc / dyn / tenc …），
+                    // 应用时再按工程里真正注册的表情校验，写错也不会出错。
+                    string abbr = ExpressionAliases.TryGetValue(key, out var alias)
+                        ? alias
+                        : pair.Key.Trim().ToLowerInvariant();
+                    expressionValues[abbr] = parsed.Value;
+                }
+            }
+
+            if (string.IsNullOrWhiteSpace(name))
+            {
+                return null;
+            }
+            return new AutoTunePreset
+            {
+                Name = name,
+                Source = source,
+                Values = values,
+                ExpressionValues = expressionValues,
+                Vibrato = vibrato,
+                ExpressionsEnabled = expressions,
+            };
+        }
+
+        private static string? NormalizeKey(string? key)
+        {
+            if (string.IsNullOrWhiteSpace(key))
+            {
+                return null;
+            }
+            var chars = key.Trim().ToLowerInvariant().Where(c => c != '_' && c != '-' && c != ' ').ToArray();
+            return chars.Length == 0 ? null : new string(chars);
+        }
+
+        private static double? ToDouble(object? value)
+        {
+            if (value == null)
+            {
+                return null;
+            }
+            if (value is double d)
+            {
+                return d;
+            }
+            if (value is int i)
+            {
+                return i;
+            }
+            if (value is float f)
+            {
+                return f;
+            }
+            string text = value.ToString()?.Trim() ?? string.Empty;
+            if (text.EndsWith("%", StringComparison.Ordinal))
+            {
+                text = text[..^1];
+            }
+            return double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out double parsed)
+                ? parsed
+                : null;
+        }
+
+        private static bool? ToBool(object? value)
+        {
+            if (value == null)
+            {
+                return null;
+            }
+            if (value is bool b)
+            {
+                return b;
+            }
+            string text = value.ToString()?.Trim().ToLowerInvariant() ?? string.Empty;
+            return text switch
+            {
+                "true" or "yes" or "on" or "1" or "是" or "开" => true,
+                "false" or "no" or "off" or "0" or "否" or "关" => false,
+                _ => null,
+            };
+        }
+
+        private static Dictionary<string, string> BuildKeyMap()
+        {
+            var map = new Dictionary<string, string>(StringComparer.Ordinal);
+            foreach (var key in SliderKeys)
+            {
+                string? normalized = NormalizeKey(key);
+                if (normalized != null)
+                {
+                    map[normalized] = key;
+                }
+            }
+            return map;
+        }
+
+        /// <summary>表情的常见写法 -> 缩写。</summary>
+        private static readonly Dictionary<string, string> ExpressionAliases = new()
+        {
+            ["tension"] = "tenc",
+            ["breath"] = "brec",
+            ["breathiness"] = "brec",
+            ["gender"] = "genc",
+            ["voicing"] = "voic",
+            ["velocity"] = "vel",
+            ["dynamics"] = "dyn",
+            ["volume"] = "dyn",
+        };
+
+        private sealed class PresetFile
+        {
+            public List<Dictionary<string, object?>>? presets { get; set; }
+        }
+    }
+}
